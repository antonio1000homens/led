# Copy to settings_local.py and fill in values for MatrixPortal S3 use.
DISPLAY_BACKEND = "matrix"
SCREEN_SOURCE = "api"
SCREEN_API_URL = "http://192.168.1.123:8000"
POLL_SECONDS = 30
ANIMATE = True
FRAME_SECONDS = 0.2

# Optional issue #94 experiment. Keep the production control unless a matched
# physical-board comparison is being run: adaptive, transition_15, or
# transition_20. This changes transition cadence only; it does not change
# marquee speed or the Matrix presentation mode.
# MATRIX_ANIMATION_PROFILE = "baseline"

WIFI_SSID = "your-wifi-name"
WIFI_PASSWORD = "your-wifi-password"
