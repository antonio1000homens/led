{
  "name": "LED CAD + slicer",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu-24.04",
  "containerEnv": {
    "BAMBU_STUDIO_VERSION": "v02.08.02.61",
    "SLICER_MACHINE_PROFILE": "Bambu Lab H2D 0.4 nozzle",
    "SLICER_PROCESS_PROFILE": "0.20mm Standard @BBL H2D",
    "SLICER_FILAMENT_PROFILE": "Bambu PLA Basic @BBL H2D"
  },
  "postCreateCommand": "bash .devcontainer/post-create.sh",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python"
      ]
    }
  },
  "forwardPorts": [
    8000
  ],
  "portsAttributes": {
    "8000": {
      "label": "LED Slicer MCP",
      "onAutoForward": "notify"
    }
  }
}
