# Copy this file to config/bootstrap-ssm-migration.env and keep the populated
# file local. It is gitignored.

REPO=antonio1000homens/led
AWS_REGION=eu-west-2
STACK_NAME=led-bootstrap
SSM_PREFIX=/led/deploy

# Leave blank to manage repository-level GitHub Actions variables. Set to an
# environment name only if this repository later moves those variables there.
GH_ENVIRONMENT=

# Optional local authentication/profile settings. Prefer existing CLI stores.
# AWS_PROFILE=your-admin-profile
# GH_TOKEN=<github-token-placeholder>
# BWS_ACCESS_TOKEN=<bitwarden-machine-token-placeholder>

# Optional Bitwarden secret UUID overrides. The migration script discovers the
# logical keys NATIONAL_RAIL_TOKEN and CF_DEPLOY_API_TOKEN when unambiguous.
# BW_NATIONAL_RAIL_TOKEN=<bitwarden-secret-uuid>
# BW_CF_DEPLOY_API_TOKEN=<bitwarden-secret-uuid>
