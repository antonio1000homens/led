# Copy to settings_local.py and fill in values for MatrixPortal S3 use.
DISPLAY_BACKEND = "matrix"
SCREEN_SOURCE = "api"
SCREEN_API_URL = "http://192.168.1.123:8000"
POLL_SECONDS = 30
ANIMATE = True
FRAME_SECONDS = 0.2

# Optional issue #94 override for a board-local comparison: adaptive,
# transition_15, transition_20, or baseline. The checked-in default is
# transition_20; this changes transition cadence only and does not change
# marquee speed or the Matrix presentation mode.
# MATRIX_ANIMATION_PROFILE = "transition_20"

WIFI_SSID = "your-wifi-name"
WIFI_PASSWORD = "your-wifi-password"
