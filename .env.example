# Runtime mode: fixture or national_rail
LED_DATA_SOURCE=fixture

# Non-secret board/server settings
LED_STATION_CRS=NEM
LED_MAX_ROWS=10
LED_CACHE_SECONDS=60
LED_SERVER_HOST=127.0.0.1
LED_SERVER_PORT=8000

# Bitwarden Secrets Manager secret UUID. Do not put the token value here.
BWS_NATIONAL_RAIL_TOKEN_SECRET_ID=
