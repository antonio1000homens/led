# Runtime mode: fixture or national_rail
LED_DATA_SOURCE=fixture

# Non-secret board/server settings
LED_STATION_CRS=NEM
LED_MAX_ROWS=10
LED_CACHE_SECONDS=60

# Calendar/Todoist is off by default because /api/screens is publicly readable.
# Local fixture mode remains available with: bash scripts/run-server.sh --calendar-source fixture
LED_CALENDAR_SOURCE=off
LED_TODOIST_CACHE_SECONDS=300
LED_TODOIST_MAX_EVENTS=6
LED_TODOIST_FILTER_QUERY=date after: yesterday
LED_TODOIST_TIMEZONE=Europe/London
LED_CALENDAR_DURATION_SECONDS=10
LED_CALENDAR_PAGE_SECONDS=5

# Thorpe Park queues are off by default. Queue-Times needs no credential and
# publishes Thorpe Park as park ID 2. Its data refreshes around every 5 minutes.
# Configured rides are displayed in this order and scroll upward beneath the
# fixed Thorpe Park heading when more than three are selected.
LED_THORPE_PARK_SOURCE=off
LED_THORPE_PARK_CACHE_SECONDS=300
LED_THORPE_PARK_RIDES=Hyperia,Stealth,The Swarm,SAW - The Ride,Nemesis Inferno,Colossus,Ghost Train,Rush,Detonator,Tidal Wave

# Current weather is enabled by default using Open-Meteo. No API key is needed.
# Coordinates default to New Malden railway station and can be changed here.
LED_WEATHER_SOURCE=open_meteo
LED_WEATHER_CACHE_SECONDS=600
LED_WEATHER_LATITUDE=51.4039
LED_WEATHER_LONGITUDE=-0.256

LED_SERVER_HOST=127.0.0.1
LED_SERVER_PORT=8000

# Bitwarden Secrets Manager secret UUID for local National Rail resolution.
# Do not put the token value here.
BWS_NATIONAL_RAIL_TOKEN_SECRET_ID=

# Production Todoist OAuth client credentials and rotating tokens are stored in
# SSM Parameter Store as the Standard SecureString /led/todoist/oauth. Seed or
# migrate it with: python3 scripts/bootstrap-todoist-oauth.py
